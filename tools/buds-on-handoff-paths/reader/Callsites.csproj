<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BudsOnCallsites</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Fixture/**/*.cs" />
    <ProjectReference Include="Fixture/Fixture.csproj" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun" />
    <EmbeddedResource Include="Fixture/bin/$(Configuration)/net8.0/BudsOnFixture.dll" LogicalName="BudsOnFixture.dll" />
  </ItemGroup>
</Project>
