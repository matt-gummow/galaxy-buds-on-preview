 namespace GalaxyBudsClient.Interface.Pages;
 
 public partial class AdvancedPage : BasePage<AdvancedPageViewModel>
 {
     private readonly string[] _restrictedItems = ["Rename"];
+    private readonly DispatcherTimer _budsOnPlaybackTimer = new() { Interval = TimeSpan.FromSeconds(1) };
+    private Device? _budsOnPlaybackDevice;
+    private bool _syncingBudsOnPlayback;
+    private bool _budsOnPlaybackBusy;
     
     public AdvancedPage()
     {
         InitializeComponent();
         AddHandler(FASettingsExpanderItem.ClickEvent, OnSettingsItemClicked);
+        if (!PlatformUtils.IsOSX)
+            return;
+
+        BudsOnGamingMode.PropertyChanged += (_, e) =>
+            OnBudsOnPlaybackSwitchChanged(e, BudsOnGamingMode, BudsOnDiagnostics.Option.GamingMode);
+        BudsOnPauseOnRemoval.PropertyChanged += (_, e) =>
+            OnBudsOnPlaybackSwitchChanged(e, BudsOnPauseOnRemoval, BudsOnDiagnostics.Option.PauseOnRemoval);
+        _budsOnPlaybackTimer.Tick += (_, _) => RefreshBudsOnPlaybackControls();
+        AttachedToVisualTree += (_, _) =>
+        {
+            _budsOnPlaybackTimer.Start();
+            RefreshBudsOnPlaybackControls();
+        };
+        DetachedFromVisualTree += (_, _) => _budsOnPlaybackTimer.Stop();
+    }
+
+    private void RefreshBudsOnPlaybackControls()
+    {
+        var bluetooth = BluetoothImpl.Instance;
+        var device = bluetooth.Device.Current is { Model: Models.BudsOn } budsOn ? budsOn : null;
+
+        BudsOnPlaybackSettings.IsVisible = device is not null;
+        // These desktop-wide actions use legacy wear events, which Buds On does not supply.
+        DesktopResumePlayback.IsVisible = device is null;
+        DesktopPausePlayback.IsVisible = device is null;
+        if (!ReferenceEquals(_budsOnPlaybackDevice, device))
+        {
+            _budsOnPlaybackDevice = device;
+            ShowBudsOnPlaybackResult(null);
+        }
+
+        if (device is null)
+            return;
+
+        var connected = CanUseBudsOnPlaybackControls(device);
+        _syncingBudsOnPlayback = true;
+        try
+        {
+            RefreshBudsOnPlaybackSwitch(BudsOnGamingMode, device, BudsOnDiagnostics.Option.GamingMode, connected);
+            RefreshBudsOnPlaybackSwitch(BudsOnPauseOnRemoval, device, BudsOnDiagnostics.Option.PauseOnRemoval, connected);
+            BudsOnRefreshPlaybackStatus.IsEnabled = connected && !_budsOnPlaybackBusy;
+        }
+        finally
+        {
+            _syncingBudsOnPlayback = false;
+        }
+    }
+
+    private static bool CanUseBudsOnPlaybackControls(Device device)
+    {
+        var bluetooth = BluetoothImpl.Instance;
+        return bluetooth.IsBudsOnSettingsDevice(device) && !bluetooth.GetBudsOnHandoffStatus(device).Starting;
+    }
+
+    private void RefreshBudsOnPlaybackSwitch(SettingsSwitchItem control, Device device,
+        BudsOnDiagnostics.Option option, bool connected)
+    {
+        var value = connected ? BudsOnDiagnostics.GetControlValue(device, option) : null;
+        var hasFreshSample = connected && BudsOnDiagnostics.GetOptionSample(device, option) is not null;
+        var readOnly = BluetoothImpl.Instance.BudsOnReadOnly;
+        control.IsChecked = value;
+        control.IsEnabled = hasFreshSample && !_budsOnPlaybackBusy && !readOnly;
+        control.Description = (value, hasFreshSample, readOnly) switch
+        {
+            (null, _, _) => "Experimental · Unavailable",
+            (_, false, _) => "Experimental · Last reported. Refresh status to make changes.",
+            (_, true, true) => "Experimental · Read-only diagnostics",
+            _ => "Experimental"
+        };
+    }
+
+    private async void OnBudsOnPlaybackSwitchChanged(AvaloniaPropertyChangedEventArgs change,
+        SettingsSwitchItem control, BudsOnDiagnostics.Option option)
+    {
+        if (_syncingBudsOnPlayback || change.Property != SettingsSwitchItem.IsCheckedProperty)
+            return;
+
+        var bluetooth = BluetoothImpl.Instance;
+        if (control.IsChecked is not { } desired ||
+            _budsOnPlaybackDevice is not { } device || !_budsOnPlaybackTimer.IsEnabled ||
+            _budsOnPlaybackBusy || bluetooth.BudsOnReadOnly || !control.IsEnabled ||
+            !CanUseBudsOnPlaybackControls(device) ||
+            BudsOnDiagnostics.GetOptionSample(device, option) is not { } sample || sample.CurrentValue == desired)
+        {
+            RefreshBudsOnPlaybackControls();
+            return;
+        }
+
+        await RunBudsOnPlaybackActionAsync(device, "Applying change…",
+            () => bluetooth.SetBudsOnOptionAsync(device, option, desired));
+    }
+
+    private async void OnRefreshBudsOnPlaybackStatus(object? sender, RoutedEventArgs e)
+    {
+        if (_budsOnPlaybackDevice is not { } device || !_budsOnPlaybackTimer.IsEnabled ||
+            _budsOnPlaybackBusy || !CanUseBudsOnPlaybackControls(device))
+            return;
+
+        await RunBudsOnPlaybackActionAsync(device, "Refreshing status…", async () =>
+            await BluetoothImpl.Instance.RefreshBudsOnStatusAsync(device) ?? "Earbud status refreshed.");
+    }
+
+    private async Task RunBudsOnPlaybackActionAsync(Device device, string progress, Func<Task<string>> action)
+    {
+        _budsOnPlaybackBusy = true;
+        ShowBudsOnPlaybackResult(progress);
+        RefreshBudsOnPlaybackControls();
+        try
+        {
+            var result = await action();
+            if (ReferenceEquals(BluetoothImpl.Instance.Device.Current, device))
+                ShowBudsOnPlaybackResult(result);
+        }
+        catch (Exception ex)
+        {
+            Serilog.Log.Warning(ex, "Buds On playback setting operation failed");
+            if (ReferenceEquals(BluetoothImpl.Instance.Device.Current, device))
+                ShowBudsOnPlaybackResult("The operation was interrupted. Refresh status before trying again.");
+        }
+        finally
+        {
+            _budsOnPlaybackBusy = false;
+            RefreshBudsOnPlaybackControls();
+        }
+    }
+
+    private void ShowBudsOnPlaybackResult(string? result)
+    {
+        BudsOnPlaybackResult.Text = result;
+        BudsOnPlaybackResult.IsVisible = !string.IsNullOrEmpty(result);
     }
 
