+    IOBluetoothDevice *device;
+    BudsOnHandoffSession *session;
+    BOOL duplicate;
+    @synchronized (self) {
+        session = _handoff;
+        duplicate = session != nil;
+        if (duplicate) {
+            session->revoked = YES;
+        } else {
+            session = [BudsOnHandoffSession new];
+            session->owner = self;
+            session->primary = mRFCOMMChannel;
+            device = [session->primary getDevice];
+            session->primaryStamp = _handoffPrimaryStamp;
+            session->handle = _handoffPrimaryHandle;
+            _handoff = session;
+            if (![self handoffPrimaryIsCurrent:session expectedMac:expectedMac]) {
+                _handoff = nil;
+                return 1;
+            }
+            session->serviceChannel = UniqueCachedChannel(device, SmepUuid);
+            if (![self handoffHasBinding:session]) {
