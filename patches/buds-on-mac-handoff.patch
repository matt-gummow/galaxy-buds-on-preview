+
+    private void RefreshHandoffControls(bool connected, bool readOnly)
+    {
+        var test = _handoff;
+        if (test != null)
+        {
+            if (!connected || readOnly || !ReferenceEquals(BluetoothImpl.Instance.Device.Current, test.Device))
+                EndHandoff("Test ended because the connection or diagnostic mode changed.");
+            else if (Stopwatch.GetElapsedTime(test.Started) >= HandoffLifetime)
+                EndHandoff("Test expired. Prepare again to retry.");
+        }
+
+        test = _handoff;
+        var open = test is { Ticket: > 0, Requested: false };
+        var listened = open && Stopwatch.GetElapsedTime(test!.Opened) >= HandoffListenTime;
+        BudsOnHandoffAvailability.Text = readOnly
+            ? "Read-only diagnostics is on. The handoff test is disabled."
+            : "Connect the Buds in GalaxyBudsClient to prepare the test.";
+        BudsOnHandoffAvailability.IsVisible = readOnly || !connected;
+        BudsOnHandoffPrepare.IsEnabled = _budsOnSettingsTimer.IsEnabled && connected &&
+                                         !readOnly && !_budsOnAudioBusy && test == null;
+        BudsOnHandoffActions.IsVisible = open;
+        BudsOnHandoffConfirm.IsEnabled = listened;
+        BudsOnHandoffRequest.IsEnabled = listened && BudsOnHandoffConfirm.IsChecked == true;
+        BudsOnHandoffEnd.IsVisible = test is { Requested: false };
+    }
