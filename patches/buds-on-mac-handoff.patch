+    NSString *canonicalExpected = [expected stringByReplacingOccurrencesOfString:@"-" withString:@":"];
+    NSString *canonicalActual = [actual stringByReplacingOccurrencesOfString:@"-" withString:@":"];
+    return [canonicalExpected caseInsensitiveCompare:canonicalActual] == NSOrderedSame;
+}
