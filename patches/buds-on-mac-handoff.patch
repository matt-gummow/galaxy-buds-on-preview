+    @synchronized (self) {
+        session->secondary = channel;
+        session->inFlight = NO;
+        if (![self handoffPrimaryIsCurrent:session expectedMac:expectedMac])
+            status = 4;
+        else if (![self handoffHasBinding:session])
+            status = 2;
