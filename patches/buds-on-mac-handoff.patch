+    private async void OnHandoffPrepare(object? sender, RoutedEventArgs e)
+    {
+        RefreshBudsOnAudioControls();
+        var bluetooth = BluetoothImpl.Instance;
+        if (!BudsOnHandoffPrepare.IsEnabled || bluetooth.Device.Current is not { } device)
+            return;
+
+        using var cancellation = new CancellationTokenSource();
+        var test = new HandoffTest(device) { Preparing = cancellation };
+        _handoff = test;
+        ShowHandoffStatus("Opening the Mac control channel…");
+        RefreshBudsOnAudioControls();
+        try
+        {
+            var (ticket, message) = await bluetooth.PrepareBudsOnHandoffAsync(device, cancellation.Token);
+            if (!ReferenceEquals(_handoff, test))
+            {
+                if (ticket != 0)
+                    bluetooth.CloseBudsOnHandoff(ticket);
+                return;
+            }
+
+            if (ticket == 0)
+                EndHandoff(message);
+            else
+            {
+                test.Opened = Stopwatch.GetTimestamp();
+                test.Ticket = ticket;
+                ShowHandoffStatus("Listen for a few seconds, then confirm whether the Fold music is still playing.");
+            }
+        }
+        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
+        {
+            // The action that ended this test already cleared its UI.
+        }
+        catch (Exception ex)
+        {
+            Serilog.Log.Warning(ex, "Buds On handoff preparation was interrupted");
+            if (ReferenceEquals(_handoff, test))
+                EndHandoff("Could not prepare the handoff test.");
+        }
+        finally
+        {
+            test.Preparing = null;
+        }
