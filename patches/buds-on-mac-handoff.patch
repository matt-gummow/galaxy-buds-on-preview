diff --git a/GalaxyBudsClient.Platform.OSX/Native/src/BudsOnHandoffGate.h b/GalaxyBudsClient.Platform.OSX/Native/src/BudsOnHandoffGate.h
new file mode 100644
index 0000000..13ec427
--- /dev/null
+++ b/GalaxyBudsClient.Platform.OSX/Native/src/BudsOnHandoffGate.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "BudsOnCallControl.h"
+
+class BudsOnHandoffGate {
+public:
+    void arm(uint64_t ticket, uint64_t nowMs) {
+        ticket_ = ticket;
+        armedAtMs_ = nowMs;
+    }
+
+    int consume(uint64_t ticket, uint64_t nowMs) {
+        if (ticket == 0 || ticket != ticket_)
+            return 4;
+
+        if (nowMs < armedAtMs_ || nowMs - armedAtMs_ >= 60000) {
+            ticket_ = 0;
+            return 4;
+        }
+        if (nowMs - armedAtMs_ < 3000)
+            return 6;
+
+        ticket_ = 0;
+        return 0;
+    }
+
+private:
+    uint64_t ticket_ = 0;
+    uint64_t armedAtMs_ = 0;
+};
+
+inline std::array<uint8_t, 9> MakeBudsOnHandoffFrame() {
+    // SM-U600 Galaxy Book trace: SMEP envelope, clear wire flag, computer class.
+    std::array<uint8_t, 9> frame{0xfc, 0x05, 0x00, 0x01, 0x71, 0x01};
+    FinishBudsOnFrame(frame);
+    frame.back() = 0xcc;
+    return frame;
+}
