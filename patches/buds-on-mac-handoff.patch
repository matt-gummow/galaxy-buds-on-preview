index 0000000..30bd5e3
--- /dev/null
+++ b/GalaxyBudsClient.Platform.OSX/BudsOnAudioRoute.cs
@@ -0,0 +1,135 @@
+using System;
+using System.Runtime.InteropServices;
+
+namespace GalaxyBudsClient.Platform.OSX;
+
+/// <summary>One read-only snapshot of the macOS system default audio output.</summary>
+public static class BudsOnAudioRoute
+{
+    private const uint SystemObject = 1;
+    private const uint GlobalScope = 0x676C6F62;   // 'glob'
+    private const uint DefaultOutput = 0x644F7574; // 'dOut'
+    private const uint TransportType = 0x7472616E; // 'tran'
+    private const uint DeviceUid = 0x75696420;     // 'uid '
+
+    private const uint Bluetooth = 0x626C7565;     // 'blue'
+    private const uint BluetoothLe = 0x626C6561;   // 'blea'
+    private const uint BuiltIn = 0x626C746E;       // 'bltn'
+    private const uint DisplayPort = 0x64707274;   // 'dprt'
+    private const uint Hdmi = 0x68646D69;          // 'hdmi'
+    private const uint Usb = 0x75736220;           // 'usb '
+    private const uint AirPlay = 0x61697270;       // 'airp'
+
+    private const string Unavailable = "unavailable";
+    private const string Other = "built-in or other output";
+    private const string Unconfirmed = "Bluetooth identity unconfirmed";
+    private const string OutputSuffix = ":output";
+
+    public static string GetDefaultOutput(string expectedMac)
+    {
+        if (!OperatingSystem.IsMacOS()) return Unavailable;
+        try
+        {
+            if (!TryReadProperty(SystemObject, DefaultOutput, out uint device) || device == 0 ||
+                !TryReadProperty(device, TransportType, out uint transport)) return Unavailable;
+
+            var uid = transport is Bluetooth or BluetoothLe ? ReadUid(device) : null;
+            // A route can disappear or change between the independent HAL property reads.
+            return TryReadProperty(SystemObject, DefaultOutput, out uint current) && current == device
+                ? Classify(transport, uid, expectedMac)
+                : Unavailable;
+        }
+        catch (DllNotFoundException) { return Unavailable; }
+        catch (EntryPointNotFoundException) { return Unavailable; }
+    }
+
+    internal static string Classify(uint transport, string? uid, string expectedMac)
+    {
+        if (transport is not (Bluetooth or BluetoothLe))
+        {
+            // Virtual and aggregate outputs may route onward to any physical device.
+            return transport is BuiltIn or DisplayPort or Hdmi or Usb or AirPlay ? Other : Unavailable;
+        }
+
+        // Match the mac-fold probe: a whole address, optionally followed by ":output".
+        var address = uid?.EndsWith(OutputSuffix, StringComparison.OrdinalIgnoreCase) == true
+            ? uid[..^OutputSuffix.Length] : uid;
+        var actual = CanonicalAddress(address);
+        var expected = CanonicalAddress(expectedMac);
+        if (actual == null || expected == null) return Unconfirmed;
+        if (actual == expected) return "selected Buds";
+        // Core Audio may expose a different identity for an LE route.
+        return transport == Bluetooth ? Other : Unconfirmed;
+    }
+
+    private static string? CanonicalAddress(string? address)
+    {
+        if (address?.Length != 17 || address[2] is not (':' or '-')) return null;
+        for (var i = 0; i < address.Length; i++)
+        {
+            if (i % 3 == 2 ? address[i] != address[2] : !char.IsAsciiHexDigit(address[i])) return null;
+        }
+        var canonical = address.Replace('-', ':').ToUpperInvariant();
+        return canonical is "00:00:00:00:00:00" or "FF:FF:FF:FF:FF:FF" ? null : canonical;
+    }
+
+    private static unsafe string? ReadUid(uint device)
+    {
+        if (!TryReadProperty(device, DeviceUid, out nint uid) || uid == 0) return null;
+        try
+        {
+            // The only recognized forms have 17 or 24 UTF-16 code units.
+            var length = CFStringGetLength(uid);
+            if (length != 17 && length != 17 + OutputSuffix.Length) return null;
+            char* buffer = stackalloc char[(int)length];
+            CFStringGetCharacters(uid, new CFRange(0, length), buffer);
+            return new string(buffer, 0, (int)length);
+        }
+        finally
+        {
+            // kAudioDevicePropertyDeviceUID passes ownership of its CFString to the caller.
+            CFRelease(uid);
+        }
+    }
+
+    private static unsafe bool TryReadProperty<T>(uint device, uint selector, out T value) where T : unmanaged
+    {
+        var address = new PropertyAddress(selector, GlobalScope, 0);
+        var size = (uint)sizeof(T);
+        T data = default;
+        var status = AudioObjectGetPropertyData(device, &address, 0, null, &size, &data);
+        value = data;
+        return status == 0 && size == sizeof(T);
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private readonly struct PropertyAddress(uint selector, uint scope, uint element)
+    {
+        public readonly uint Selector = selector;
+        public readonly uint Scope = scope;
+        public readonly uint Element = element;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private readonly struct CFRange(nint location, nint length)
+    {
+        public readonly nint Location = location;
+        public readonly nint Length = length;
+    }
+
+    private const string CoreAudio = "/System/Library/Frameworks/CoreAudio.framework/CoreAudio";
+    private const string CoreFoundation = "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
+
+    [DllImport(CoreAudio)]
+    private static extern unsafe int AudioObjectGetPropertyData(uint device, PropertyAddress* address,
+        uint qualifierSize, void* qualifier, uint* size, void* data);
+
+    [DllImport(CoreFoundation)]
+    private static extern nint CFStringGetLength(nint value);
+
+    [DllImport(CoreFoundation)]
+    private static extern unsafe void CFStringGetCharacters(nint value, CFRange range, char* characters);
+
+    [DllImport(CoreFoundation)]
+    private static extern void CFRelease(nint value);
+}
