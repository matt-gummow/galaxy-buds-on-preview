+// getServiceRecordForUUID may match a UUID elsewhere in an SDP record.
+// Require one service-class record and reject a second record sharing its channel.
+static BluetoothRFCOMMChannelID UniqueCachedChannel(IOBluetoothDevice *device, const UInt8 (&wanted)[16]) {
+    unsigned int uses[31] = {};
+    BluetoothRFCOMMChannelID result = 0;
+    for (IOBluetoothSDPServiceRecord *record in device.services) {
+        BluetoothRFCOMMChannelID channel = 0;
+        bool rfcomm = [record getRFCOMMChannelID:&channel] == kIOReturnSuccess &&
+            channel > 0 && channel <= 30;
+        if (rfcomm)
+            ++uses[channel];
+        NSArray *classes = [[record getAttributeDataElement:kBluetoothSDPAttributeIdentifierServiceClassIDList] getArrayValue];
+        for (IOBluetoothSDPDataElement *element in classes) {
+            IOBluetoothSDPUUID *uuid = [[element getUUIDValue] getUUIDWithLength:16];
+            if (uuid.length == sizeof(wanted) && memcmp(uuid.bytes, wanted, sizeof(wanted)) == 0) {
+                if (result || !rfcomm)
+                    return 0;
+                result = channel;
+                break;
+            }
+        }
+    }
+    return result && uses[result] == 1 ? result : 0;
+}
