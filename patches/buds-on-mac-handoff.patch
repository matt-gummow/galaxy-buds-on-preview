+// Revocation takes effect under the lock. A synchronous system call in progress
+// retains the reservation and performs cleanup on return, so a second open
+// cannot acquire an old channel while its delegate is still being detached.
+- (void)endHandoff:(BudsOnHandoffSession *)session {
+    IOBluetoothRFCOMMChannel *secondary;
+    @synchronized (self) {
+        if (!session || _handoff != session)
+            return;
+        session->revoked = YES;
+        if (session->inFlight || session->closing)
+            return;
+        session->closing = YES;
+        secondary = session->secondary;
+    }
