+            status = 3;
+        else {
+            session->gate.arm(session->ticket, HandoffTimeMs());
+            *outTicket = session->ticket;
+            status = 0;
+        }
+        if (status)
+            session->revoked = YES;
+    }
+    // IOBluetooth documents an extra caller-owned retain on successful open.
+    // session->secondary and this local are already strong ARC references.
+    if (openStatus == kIOReturnSuccess && channel)
+        CFRelease((__bridge CFTypeRef)channel);
+    if (status) {
+        [self endHandoff:session];
+        return status;
+    }
+
+    __weak Bluetooth *weakSelf = self;
+    uint64_t ticket = session->ticket;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC),
+                   dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        [weakSelf closeBudsOnHandoff:ticket];
+    });
+    return 0;
+}
+
+- (int)requestBudsOnHandoff:(NSString *)expectedMac ticket:(uint64_t)ticket {
+    if ([NSThread isMainThread])
+        return 5;
+    BudsOnHandoffSession *session;
+    IOBluetoothRFCOMMChannel *channel;
+    auto frame = MakeBudsOnHandoffFrame();
+    int status;
+    @synchronized (self) {
+        session = _handoff;
+        if (!ticket || !session || session->ticket != ticket || session->inFlight || session->revoked)
+            return 4;
+        channel = session->secondary;
+        if (![self handoffPrimaryIsCurrent:session expectedMac:expectedMac])
+            status = 1;
+        else if (![self handoffHasBinding:session])
+            status = 2;
+        else if (!channel || channel == session->primary || ![channel isOpen] || [channel isIncoming] ||
+                 [channel getDevice] != [session->primary getDevice] ||
+                 [channel getChannelID] != session->serviceChannel || [channel delegate] != session)
+            status = 4;
+        else if ([channel getMTU] < frame.size())
+            status = 5;
+        else
+            status = session->gate.consume(ticket, HandoffTimeMs());
+        if (status == 6)
+            return status;
+        if (status == 0)
+            session->inFlight = YES;
+        else
+            session->revoked = YES;
+    }
+
+    if (status == 0) {
+        // Consumed before this call. A failed or partial local send is final.
+        // The retained secondary cannot redirect a write to a new connection.
+        status = [channel writeSync:frame.data() length:static_cast<UInt16>(frame.size())] == kIOReturnSuccess ? 0 : 5;
+        @synchronized (self) {
+            session->revoked = YES;
+            session->inFlight = NO;
+        }
+    }
+    [self endHandoff:session];
+    return status;
+}
