+// Called under the client lock. The primary is an established diagnostic SppNew
+// channel. The handle and opening stamp bind the ticket to that connection.
+- (BOOL)handoffPrimaryIsCurrent:(BudsOnHandoffSession *)session expectedMac:(NSString *)mac {
+    IOBluetoothRFCOMMChannel *primary = mRFCOMMChannel;
+    IOBluetoothDevice *device = [primary getDevice];
