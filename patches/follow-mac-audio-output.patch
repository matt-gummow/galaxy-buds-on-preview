diff --git a/GalaxyBudsClient/Platform/BluetoothImpl.AudioOutput.cs b/GalaxyBudsClient/Platform/BluetoothImpl.AudioOutput.cs
new file mode 100644
index 0000000000000000000000000000000000000000..414e033d0efef82cc1055c416248b6fa0b844b8f
--- /dev/null
+++ b/GalaxyBudsClient/Platform/BluetoothImpl.AudioOutput.cs
@@ -0,0 +1,82 @@
+#if OSX
+using System;
+using System.Linq;
+using System.Threading;
+using Avalonia.Threading;
+using GalaxyBudsClient.Message;
+using GalaxyBudsClient.Model.Config;
+using GalaxyBudsClient.Model.Constants;
+using Serilog;
+
+namespace GalaxyBudsClient.Platform;
+
+public sealed partial class BluetoothImpl
+{
+    private readonly DispatcherTimer _audioOutputTimer = new() { Interval = TimeSpan.FromSeconds(1) };
+    private string? _observedMacAudioAddress;
+    private bool _followedObservedOutput;
+    private int _connectRequests;
+
+    private async void FollowMacAudioOutput(object? sender, EventArgs args)
+    {
+        if (!Settings.Data.FollowMacAudioOutput)
+        {
+            _observedMacAudioAddress = null;
+            _followedObservedOutput = false;
+            return;
+        }
+
+        var address = OSX.BudsOnAudioRoute.GetDefaultBluetoothAddress();
+        if (address != _observedMacAudioAddress)
+        {
+            _observedMacAudioAddress = address;
+            _followedObservedOutput = false;
+            return;
+        }
+
+        if (address is null || _followedObservedOutput || _backend is not OSX.BluetoothService backend ||
+            Volatile.Read(ref _connectRequests) != 0 || AlternativeModeEnabled || SuppressDisconnectionEvents)
+            return;
+
+        var output = Settings.Data.Devices.FirstOrDefault(device => device.Model != Models.NULL &&
+            string.Equals(device.MacAddress.Replace('-', ':'), address, StringComparison.OrdinalIgnoreCase));
+        if (output is null)
+            return;
+        if (ReferenceEquals(output, Device.Current))
+        {
+            _followedObservedOutput = IsConnected;
+            return;
+        }
+        if (IsConnected || backend.IsStreamConnected ||
+            (Device.Current is { Model: Models.BudsOn } previous && GetBudsOnHandoffStatus(previous) != (0UL, false)))
+            return;
+
+        // Let the last connection's receive loop finish before changing the model used for decoding.
+        if (!Monitor.TryEnter(IncomingQueue))
+            return;
+        try
+        {
+            if (!backend.StopReconnectIfIdle())
+                return;
+            IncomingQueue.Clear();
+            _incomingData.Clear();
+            DeviceMessageCache.Instance.Clear();
+        }
+        finally
+        {
+            Monitor.Exit(IncomingQueue);
+        }
+
+        _followedObservedOutput = true;
+        Device.Current = output;
+        try
+        {
+            await ConnectAsync(output);
+        }
+        catch (Exception ex)
+        {
+            Log.Warning(ex, "Unable to follow the Mac audio output");
+        }
+    }
+}
+#endif
